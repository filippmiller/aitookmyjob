{
  "name": "aitookmyjob",
  "version": "1.0.0",
  "description": "Minimal deployable website for Coolify/Hetzner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "news:ingest": "node scripts/ingest-news.js",
    "jobs:worker": "node scripts/job-worker.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:status": "node scripts/db-status.js",
    "db:backup": "node scripts/backup-pg.js",
    "db:restore": "node scripts/restore-pg.js",
    "test:domain": "node --test tests/domain-contract.test.js",
    "test:migrations": "node --test tests/migrations.test.js",
    "test:storage": "node --test tests/storage-routing.test.js",
    "test:jobs": "node --test tests/jobs.test.js",
    "test:observability": "node --test tests/observability.test.js",
    "test:expression": "node --test tests/expression.test.js",
    "test:insider": "node --test tests/insider.test.js",
    "test:notifications": "node --test tests/notifications.test.js",
    "test:resources": "node --test tests/resources-catalog.test.js",
    "test:unit": "node --test tests/domain-contract.test.js tests/migrations.test.js tests/storage-routing.test.js tests/jobs.test.js tests/observability.test.js tests/expression.test.js tests/insider.test.js tests/notifications.test.js tests/resources-catalog.test.js",
    "test:secrets": "node scripts/ci-secret-scan.js",
    "test:audit": "node scripts/ci-audit.js",
    "test:migrate-check": "node scripts/ci-migrate-check.js",
    "test:smoke": "playwright test -c playwright.smoke.config.mjs",
    "test:deploy-smoke": "node scripts/deploy-smoke.js",
    "ci": "npm run test:secrets && npm run test:audit && npm run test:migrate-check && npm run test:unit && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.18.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
